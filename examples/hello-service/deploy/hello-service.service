[Unit]
Description=Foundation-managed hello service Compose deployment
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/hello-service/current
EnvironmentFile=/etc/hello-service/production.env
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.yml down
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
